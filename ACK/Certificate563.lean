def scaledBasis (k : Fin 14) (j : Fin 52) : ℤ :=
  (scaledBasisRows.getD k.val []).getD j.val 0

def integerAdjacency (i j : Fin 52) : ℤ :=
  if edge i j then 1 else 0

theorem integer_reconstruction :
    ∀ i j : Fin 52,
      (3 : ℤ) * integerAdjacency i j =
        ∑ k : Fin 14,
          integerAdjacency i (pivotIndex k) * scaledBasis k j := by
  decide

end ACK.Witness563

#print axioms ACK.Witness563.integer_reconstruction
