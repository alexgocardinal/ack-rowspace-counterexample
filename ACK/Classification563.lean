def classificationCode (lo hi : Fin 128) : Nat :=
  (classificationCodes.getD hi.val []).getD lo.val 0

def integerExtension (m j : Nat) : ℤ :=
  ∑ k : Fin 14,
    if m.testBit k.val then
      (scaledBasisRows.getD k.val []).getD j 0
    else 0

abbrev ClassificationCheck (lo hi : Fin 128) : Prop :=
  let m := lo.val + 128 * hi.val
  let c := classificationCode lo hi
  if c = 0 then
    m = 0
  else if c ≤ 52 then
    m = (rowMasks.getD (c - 1) 0) % 16384
  else
    c ≤ 104 ∧
      integerExtension m (c - 53) ≠ 0 ∧
      integerExtension m (c - 53) ≠ 3

